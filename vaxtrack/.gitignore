# Nuvexa Git Ignore

# Local Database & Dynamic Runtime Data (Contains sensitive patient and provider data)
data/
*.tmp

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Node / Dependency directories (Nuvexa has zero dependencies, but standard ignore)
node_modules/

# Environment Variables & Secrets
.env
.env.*

# OS and Editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
